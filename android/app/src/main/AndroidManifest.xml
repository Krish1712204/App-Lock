<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Lets the app show Android's fingerprint popup. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC"/>
    <!-- "Display over other apps". Must be listed here, or App Lock wouldn't
         even appear on that settings page. Helps Android allow the lock
         screen to open on top of other apps. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW"/>
    <!-- Lets App Lock show Android's "Let app always run in background?"
         popup (Battery: Unrestricted). -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"/>

    <!-- allowBackup="false": the PIN hash is encrypted with a key that never
         leaves this phone, so a cloud backup of it would be useless anyway
         (and could break the app after a restore). -->
    <!-- android:name: our AppLockApplication runs first when the app starts,
         and pre-warms the lock screen's Flutter engine. -->
    <application
        android:label="App Lock"
        android:name=".AppLockApplication"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:allowBackup="false">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <!-- The lock screen that covers locked apps (LockActivity.kt).
             - singleInstance + own taskAffinity: lives in its own task, so
               closing it shows the locked app underneath again.
             - excludeFromRecents: never appears in Recent apps.
             - exported="false": other apps can't open it. -->
        <activity
            android:name=".LockActivity"
            android:exported="false"
            android:launchMode="singleInstance"
            android:taskAffinity="com.krishna.applock.lock"
            android:excludeFromRecents="true"
            android:theme="@style/LockTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize" />

        <!-- The watcher (LockAccessibilityService.kt). Only Android itself can
             connect to it, because of the BIND_ACCESSIBILITY_SERVICE permission.
             The meta-data points to its settings file in res/xml. -->
        <service
            android:name=".LockAccessibilityService"
            android:label="@string/accessibility_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService"/>
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config"/>
        </service>

        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- Since Android 11, apps can't see other apps unless they say why.
             These two let App Lock see (1) apps with an icon in the app
             drawer, for the Home list, and (2) the home-screen app, so the
             watcher can ignore it. This is narrower than QUERY_ALL_PACKAGES. -->
        <intent>
            <action android:name="android.intent.action.MAIN"/>
            <category android:name="android.intent.category.LAUNCHER"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN"/>
            <category android:name="android.intent.category.HOME"/>
        </intent>
        <!-- The "Uninstall?" dialog comes from the package installer, which
             has no app-drawer icon. "Lock Settings & Play Store" locks it, so
             the watcher must be able to see it. -->
        <package android:name="com.google.android.packageinstaller"/>
        <package android:name="com.android.packageinstaller"/>
    </queries>
</manifest>
